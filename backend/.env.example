# ---- Sourcewell backend config ----
# Copy to .env. Everything here is optional for a local run: with no keys set you still get
# email+password signup (mail lands in Mailpit on http://localhost:8904), and the Google /
# Microsoft buttons hide themselves via GET /auth/options.

FRONTEND_URL=http://localhost:8900
# Absolute base URL of THIS API. Verification, reset and unsubscribe links are built from it, and
# it's the host Unipile's webhooks are pointed at — through a tunnel (ngrok/cloudflared) if the
# provider has to reach you from the internet.
API_BASE_URL=http://localhost:8901

# ---- WorkOS (brokers the Google / Microsoft OAuth buttons) ----
# Sourcewell never talks to Google or Microsoft directly — WorkOS holds those client secrets and
# hands us back a verified email. So there is nothing to configure here per provider; the buttons
# are pinned to `GoogleOAuth` / `MicrosoftOAuth` in code (services/workspace/auth.py).
#
# 1) Create an app at https://dashboard.workos.com
# 2) Copy the API key + Client ID below
# 3) Redirects > add this EXACT redirect URI:  http://localhost:8901/auth/callback
#    (the API, not the React app — the browser is bounced onward from there)
# 4) Authentication > Google OAuth: paste a GCP OAuth 2.0 Client ID + secret, whose own
#    "Authorized redirect URI" is the one WorkOS shows you (https://api.workos.com/sso/oauth/
#    google/callback), NOT ours.
# 5) Authentication > Microsoft OAuth: same shape with an Azure AD app registration.
# Until 4/5 are done the buttons render and redirect, and WorkOS reports the provider is not
# configured — nothing on our side changes.
WORKOS_API_KEY=sk_test_xxx
WORKOS_CLIENT_ID=client_xxx
WORKOS_REDIRECT_URI=http://localhost:8901/auth/callback

# Fernet key that seals the session cookie (freshly generated below — keep it secret).
# Regenerate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_COOKIE_PASSWORD=cUYdTpasVSgR9RKRn_d2uAB5o-1ZkQ9CSPgjbPXVX6A=
COOKIE_SECURE=false

# HMAC key for email-verification, password-reset and unsubscribe links. Falls back to the cookie
# key when blank; required (and checked at startup) outside local.
SIGNING_SECRET=

# ---- Transactional email (verification + password reset) ----
# Blank RESEND_API_KEY = plain SMTP, which locally means Mailpit — open http://localhost:8904 to
# read the confirmation mail. Resend delivers over HTTPS, for hosts that block outbound SMTP.
RESEND_API_KEY=
TRANSACTIONAL_FROM_EMAIL=Sourcewell <hello@sourcewell.dev>
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
# 1 = never transmit; a send is a no-op reported as "sent". The test suite sets this.
EMAIL_DRY_RUN=0
LINKEDIN_DRY_RUN=0

# ---- Unipile (LinkedIn + email sending seats) ----
# LinkedIn is not a sign-in method — recruiters connect it from Settings as a sending seat.
# Blank = the connect button reports "not configured", LinkedIn sends are dry-run no-ops, and
# email falls back to SMTP/Mailpit.
#   1) Dashboard: https://dashboard.unipile.com  (DSN on the home page; token under Access Tokens)
#   2) Recruiters connect their own seat via Settings → the hosted-auth flow (account_id is stored
#      on their Connection; UNIPILE_ACCOUNT_ID below is only a single-account spike fallback).
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
# Shared secret carried in the webhook URL (?token=). Gates BOTH the inbound message receiver and
# the hosted-auth notify hop — without it a seat connect has nowhere to report back to.
UNIPILE_WEBHOOK_SECRET=

# ---- Generic inbound email receiver ----
# Shared secret an email provider HMAC-signs POST /webhooks/inbound bodies with. Blank disables
# that endpoint (503).
INBOUND_WEBHOOK_SECRET=
